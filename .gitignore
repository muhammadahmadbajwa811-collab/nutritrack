proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA / VS Code
*.iml
.idea/
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/workspace.xml
.vscode/

